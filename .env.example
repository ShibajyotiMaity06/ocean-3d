# OceanView 3D - Environment Variables
# Add your Gemini or Groq API Key below for all users:

# 1. Google Gemini API Key (Recommended)
VITE_GEMINI_API_KEY=

# 2. Groq API Key (Optional)
VITE_GROQ_API_KEY=

# 3. Custom Backend Proxy Endpoint (Optional)
# VITE_AI_BACKEND_URL=http://localhost:5000/api/chat
